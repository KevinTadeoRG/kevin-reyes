# Copia este archivo a infra/.env (no se versiona) y llena los valores.

# Correo verificado como identidad en Amazon SES (us-east-1). Es remitente y destinatario.
CONTACT_EMAIL=tu-correo@example.com

# Orígenes que pueden usar la API, separados por coma (opcional).
