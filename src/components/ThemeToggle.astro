---
import type { Ui } from '../data/schema.ts';

interface Props {
  labels: Ui['a11y'];
}

const { labels } = Astro.props;
const icon = 'size-4.5';
---

<!-- Oculto hasta que corre el script: sin JavaScript el sitio sigue el tema del sistema. -->
<button
  type="button"
  hidden
  data-theme-toggle
  data-label-dark={labels.themeToDark}
  data-label-light={labels.themeToLight}
  aria-label={labels.themeToDark}
  class="group inline-flex size-9 items-center justify-center rounded-md text-muted transition-colors hover:bg-surface hover:text-fg"
>
  <!-- Luna: se muestra en modo claro (acción: pasar a oscuro) -->
  <svg
    aria-hidden="true"
    class:list={[icon, 'group-data-[current=dark]:hidden']}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <!-- Sol: se muestra en modo oscuro (acción: pasar a claro) -->
  <svg
    aria-hidden="true"
    class:list={[icon, 'hidden group-data-[current=dark]:block']}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>
