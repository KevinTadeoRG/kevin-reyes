---
import type { SectionId } from '../data/index.ts';

interface Props {
  id: SectionId;
  /** Número de la sección (01, 02…), decorativo. */
  index: number;
  title: string;
}

const { id, index, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-line">
  <div class="mx-auto grid max-w-5xl gap-6 px-4 py-14 sm:px-6 md:grid-cols-[10rem_1fr] md:gap-12 md:py-20">
    <div class="self-start md:sticky md:top-24">
      <p class="font-mono text-xs text-muted" aria-hidden="true">
        {String(index).padStart(2, '0')}
      </p>
      <h2 id={`${id}-title`} class="mt-1 text-lg font-semibold tracking-tight">
        {title}
      </h2>
    </div>
    <div class="min-w-0">
      <slot />
    </div>
  </div>
</section>
