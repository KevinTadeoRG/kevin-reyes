---
import { getUi, type Locale } from '../../data/index.ts';
import Section from '../Section.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const ui = getUi(lang);
---

<!-- Placeholder hasta la Fase 7 (casos de estudio). -->
<Section id="projects" index={4} title={ui.nav.projects}>
  <p class="rounded-lg border border-dashed border-line px-5 py-8 font-mono text-sm text-muted">
    {ui.projects.placeholder}
  </p>
</Section>
