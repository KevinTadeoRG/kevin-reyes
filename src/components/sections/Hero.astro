---
import { getContent, getUi, person, type Locale } from '../../data/index.ts';
import { getCvHref } from '../../lib/cv.ts';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { profile } = getContent(lang);
const ui = getUi(lang);
const cvHref = getCvHref(lang);

const primary =
  'inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-accent-fg transition-colors hover:bg-accent/90';
const secondary =
  'inline-flex items-center gap-2 rounded-md border border-line bg-surface px-4 py-2.5 text-sm font-medium transition-colors hover:border-muted';
---

<section
  id="top"
  aria-labelledby="hero-title"
  class="mx-auto max-w-5xl px-4 pt-14 pb-16 sm:px-6 md:pt-24 md:pb-24"
>
  <p class="flex items-center gap-2 font-mono text-xs text-muted sm:text-sm">
    <svg
      aria-hidden="true"
      class="size-3.5 text-accent"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
      <circle cx="12" cy="10" r="3"></circle>
    </svg>
    {profile.location}
  </p>

  <h1 id="hero-title" class="mt-5 text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
    {person.name}
  </h1>
  <p class="mt-3 text-xl font-medium text-accent sm:text-2xl">{profile.headline.role}</p>

  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-muted">
    {profile.valueProposition}
  </p>

  <ul class="mt-6 flex flex-wrap gap-2">
    {profile.headline.keywords.map((keyword) => (
      <li class="rounded-md border border-line bg-surface px-2.5 py-1 font-mono text-xs">
        {keyword}
      </li>
    ))}
  </ul>

  <div class="mt-10 flex flex-wrap gap-3">
    {cvHref && (
      <a href={cvHref} download class={primary}>
        <svg
          aria-hidden="true"
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" />
        </svg>
        {ui.hero.downloadCv}
      </a>
    )}
    <a href="#contact" class={cvHref ? secondary : primary}>
      {ui.hero.contact}
    </a>
  </div>
</section>
