---
import { person } from '../data/index.ts';
import { encodeEmailPart } from '../lib/email.ts';

interface Props {
  revealLabel: string;
}

const { revealLabel } = Astro.props;
---

<!-- El correo nunca va completo en el HTML: se ensambla en el cliente al hacer clic (src/scripts/site.ts). -->
<div
  data-email
  data-u={encodeEmailPart(person.email.user)}
  data-d={encodeEmailPart(person.email.domain)}
>
  <button
    type="button"
    hidden
    class="rounded-md border border-line bg-surface px-3 py-1.5 text-sm font-medium transition-colors hover:border-muted"
  >
    {revealLabel}
  </button>
  <a
    hidden
    class="break-all underline decoration-line underline-offset-4 hover:decoration-accent"
  ></a>
</div>
