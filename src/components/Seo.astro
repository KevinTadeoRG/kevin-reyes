---
import { getContent, LOCALES, person, type Locale } from '../data/index.ts';
import { localePath } from '../lib/i18n.ts';
import {
  absoluteUrl,
  alternates,
  OG_IMAGE,
  OG_LOCALE,
  personJsonLd,
  serializeJsonLd,
} from '../lib/seo.ts';

interface Props {
  lang: Locale;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;

// La URL base vive en un solo lugar: `site` en astro.config.mjs.
const site = Astro.site;
if (!site) throw new Error('Falta `site` en astro.config.mjs');

const canonical = absoluteUrl(site, localePath(lang));
const ogImage = absoluteUrl(site, OG_IMAGE.path);
const jsonLd = serializeJsonLd(personJsonLd(person, getContent(lang), canonical));
---

<link rel="canonical" href={canonical} />
{alternates(site).map((alt) => (
  <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
))}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={person.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
{LOCALES.filter((l) => l !== lang).map((l) => (
  <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
))}
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content={OG_IMAGE.type} />
<meta property="og:image:width" content={String(OG_IMAGE.width)} />
<meta property="og:image:height" content={String(OG_IMAGE.height)} />
<meta property="og:image:alt" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

<script type="application/ld+json" set:html={jsonLd} />
