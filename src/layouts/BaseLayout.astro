---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  lang: 'es' | 'en';
  title: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />
    <!-- Aplica el tema guardado antes de pintar, para evitar un destello del tema equivocado. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {
        // Sin almacenamiento: se usa el tema del sistema.
      }
    </script>
  </head>
  <body class="min-h-dvh bg-bg font-sans text-fg antialiased">
    <slot />
  </body>
</html>
